{
  "name": "little-lilies-pre-school",
  "version": "0.1.0",
  "description": "Little Lilies Pre-School website \u2014 Mogoditshane, Botswana",
  "main": "index.html",
  "scripts": {
    "css": "tailwindcss -i src/tailwind.css -o public/assets/tailwind.css --minify",
    "css:watch": "tailwindcss -i src/tailwind.css -o public/assets/tailwind.css --watch",
    "dev": "npm run css && vite",
    "build": "npm run css && vite build",
    "preview": "vite preview",
    "docs": "node scripts/render-docs.mjs"
  },
  "keywords": [
    "preschool",
    "school",
    "early-childhood",
    "botswana",
    "mogoditshane"
  ],
  "author": "TapxMedia",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19",
    "vite": "^5.2.0"
  }
}
